{
  "manifest_version": 3,
  "name": "VOE Helper",
  "version": "1.0.0",
  "description": "Instant VOE/VOI provider and employer code lookup.", "permissions": [
  "contextMenus",
  "storage",
  "activeTab",
  "scripting",
  "alarms",
  "clipboardWrite",
  "offscreen"
 ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VOE Helper Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  }
}
