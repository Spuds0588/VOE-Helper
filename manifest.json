{
  "manifest_version": 3,
  "name": "VOE Helper",
  "version": "1.1.0",
  "version_name": "1.1.0-alpha",
  "description": "Instant VOE/VOI provider and employer code lookup.",  "permissions": [
  "contextMenus",
  "storage",
  "activeTab",
  "scripting",
  "alarms",
  "clipboardWrite",
  "offscreen",
  "sidePanel"
 ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://app.truework.com/requester/quickstart*"],
      "js": ["truework-prefill.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["click-tracker.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VOE Helper Status",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "wvoe.html",
        "wvoe.js",
        "voe-search.html",
        "voe-search.js",
        "sidepanel.html",
        "sidepanel.js",
        "vendor/pdfme-generator.iife.min.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
